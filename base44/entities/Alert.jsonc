{
  "name": "Alert",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Parent site id"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "category": {
      "type": "string",
      "enum": [
        "equipment",
        "crop",
        "weather",
        "disease",
        "security",
        "communication",
        "automation"
      ],
      "default": "equipment"
    },
    "zone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved"
      ],
      "default": "active"
    }
  },
  "required": [
    "title",
    "severity"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
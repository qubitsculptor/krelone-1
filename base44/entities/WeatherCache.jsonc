{
  "name": "WeatherCache",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Site this cached forecast belongs to"
    },
    "data": {
      "type": "object",
      "description": "Cached Open-Meteo response payload",
      "additionalProperties": true
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "site_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
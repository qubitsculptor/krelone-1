{
  "name": "Task",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Parent site id"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "inspection",
        "maintenance",
        "cleaning",
        "repair",
        "harvest",
        "calibration",
        "scouting"
      ],
      "default": "inspection"
    },
    "zone": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done",
        "verified"
      ],
      "default": "open"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "auto_created": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
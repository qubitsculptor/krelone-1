{
  "name": "Automation",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Parent site id"
    },
    "name": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "enum": [
        "irrigation",
        "valve",
        "pump",
        "tracker",
        "vent",
        "fan",
        "fogger",
        "lighting",
        "notification"
      ],
      "default": "irrigation"
    },
    "zone": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "description": "condition description"
    },
    "action": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "observe",
        "recommend",
        "approve",
        "autonomous"
      ],
      "default": "recommend"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_run": {
      "type": "string",
      "format": "date-time"
    },
    "runs_today": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "target"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.site_id": "{{user.data.site_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}